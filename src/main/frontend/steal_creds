function getCookies() {
    const cookies = document.cookie.split('; ').reduce((acc, cookie) => {
        const [name, ...rest] = cookie.split('=');
        acc[name] = rest.join('=');
        return acc;
    }, {});

    const result = {
        leetCodeSession: cookies['LEETCODE_SESSION'] || 'error_leetcode',
        csrfToken: cookies['csrftoken'] || 'error_csrftoken',
        cf_clearance: cookies['cf_clearance'] || 'error_cf_clearance'
    };

    console.log('steal cookies');
    console.log(JSON.stringify(result, null, 2));

    navigator.clipboard.writeText(JSON.stringify(result, null, 2))
        .then(() => console.log('JSON copied'))
        .catch(err => console.log('JSON not copied: ', err));
};